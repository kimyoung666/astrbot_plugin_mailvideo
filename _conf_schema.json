{
  "site_url": {
    "description": "站点地址",
    "type": "string",
    "default": "",
    "hint": "直接填站点链接就行，比如 https://example.com。搜索入口会自动去试，不用再写 JSON。"
  },
  "proxy": {
    "description": "下载/搜片走的代理",
    "type": "string",
    "default": "http://127.0.0.1:7890",
    "hint": "留空则直连；支持 http:// 与 socks5://"
  },
  "max_results": {
    "description": "每次返回几条候选",
    "type": "int",
    "default": 10
  },
  "max_filesize_mb": {
    "description": "单个文件大小上限(MB)",
    "type": "int",
    "default": 120,
    "hint": "0 表示不限制"
  },
  "max_send_mb": {
    "description": "超过多少 MB 改用文件发送",
    "type": "int",
    "default": 80
  },
  "send_as_file": {
    "description": "一律以文件形式发送（不走视频消息）",
    "type": "bool",
    "default": false
  },
  "cookiefile": {
    "description": "年龄验证cookies",
    "type": "string",
    "default": "",
    "hint": "填导出好的 cookies.txt 绝对路径，Netscape 格式；需要登录/过年龄验证的站点用"
  },
  "timeout": {
    "description": "搜索请求超时(秒)",
    "type": "int",
    "default": 20
  },
  "download_timeout": {
    "description": "下载超时(秒)",
    "type": "int",
    "default": 600
  },
  "pending_ttl": {
    "description": "搜索结果有效期(秒)",
    "type": "int",
    "default": 600
  }
}
